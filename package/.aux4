{
  "scope": "aux4",
  "name": "computer-mac",
  "version": "0.7.4",
  "description": "Computer-use for AI agents on macOS: screenshot, read the accessibility tree, click, type, keyboard shortcuts, scroll, drag, clipboard and app/window control",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "macos",
    "computer-use",
    "accessibility",
    "automation",
    "agent",
    "ai-skill"
  ],
  "dependencies": [
    "aux4/computer"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "computer",
          "execute": [
            "profile:computer"
          ],
          "help": {
            "text": "Computer-use commands for AI agents"
          }
        },
        {
          "name": "ai",
          "execute": [
            "profile:ai"
          ],
          "help": {
            "text": "Artificial Intelligence"
          }
        }
      ]
    },
    {
      "name": "computer",
      "commands": [
        {
          "name": "mac",
          "execute": [
            "profile:computer:mac"
          ],
          "help": {
            "text": "Operate this Mac: screenshot, read, click, type, shortcuts, clipboard, apps/windows"
          }
        }
      ]
    },
    {
      "name": "computer:mac",
      "commands": [
        {
          "name": "info",
          "execute": [
            "${packageDir}/aux4-computer-mac info ${packageDir}"
          ],
          "help": {
            "text": "Describe this provider for aux4/computer: provider name, contract version, platform, version, capabilities and permissions (JSON)"
          }
        },
        {
          "name": "notes",
          "execute": [
            "cat ${packageDir}/instructions/notes.md"
          ],
          "help": {
            "text": "macOS specifics for agents (markdown): permissions, background limits, data-loss and OCR gotchas, coordinates"
          }
        },
        {
          "name": "permissions",
          "execute": [
            "${packageDir}/aux4-computer-mac permissions"
          ],
          "help": {
            "text": "Check Accessibility and Screen Recording permission status"
          }
        },
        {
          "name": "screenshot",
          "execute": [
            "${packageDir}/aux4-computer-mac screenshot values(output, display, app, maxWidth, annotate, roles, limit)"
          ],
          "help": {
            "text": "Capture a screenshot of a display or a specific app's window",
            "variables": [
              {
                "name": "output",
                "text": "File path to save the PNG to (defaults to a temp file)",
                "default": ""
              },
              {
                "name": "display",
                "text": "Display index to capture (from 'computer mac screen')",
                "default": "0"
              },
              {
                "name": "app",
                "text": "Capture this app's front window (even when covered by other windows) instead of a display",
                "default": ""
              },
              {
                "name": "maxWidth",
                "text": "Resize down if wider than this, preserving aspect ratio",
                "default": "1568"
              },
              {
                "name": "annotate",
                "text": "Draw a numbered box on each element (set-of-marks) and return the marks: number, ref, role, label, frame, center, windowCenter",
                "default": "false",
                "options": [
                  "false",
                  "true"
                ]
              },
              {
                "name": "roles",
                "text": "With --annotate: actionable (default: buttons, links, fields, checkboxes, menus, pop-ups, tabs, rows) or all (also text, images, headings, cells)",
                "default": "actionable",
                "options": [
                  "actionable",
                  "all"
                ]
              },
              {
                "name": "limit",
                "text": "With --annotate: most marks to draw (the rest are reported as truncated)",
                "default": "150"
              }
            ]
          }
        },
        {
          "name": "ocr",
          "execute": [
            "${packageDir}/aux4-computer-mac ocr values(app, image, text, level, languages, mode, scale, timeout)"
          ],
          "help": {
            "text": "Recognize text on the screen, an app's window or a PNG, with positions in click coordinates",
            "variables": [
              {
                "name": "app",
                "text": "Read this app's front window (even when covered by other windows); positions are also given relative to it as windowCenter, the space 'click --app' uses",
                "default": ""
              },
              {
                "name": "image",
                "text": "Recognize an existing PNG instead of capturing the screen (no Screen Recording permission needed)",
                "default": ""
              },
              {
                "name": "text",
                "text": "Only return lines containing this text (case-insensitive); each line also gets a 'match' with the position of just that text",
                "default": ""
              },
              {
                "name": "level",
                "text": "accurate (default) or fast recognition",
                "default": "accurate",
                "options": [
                  "accurate",
                  "fast"
                ]
              },
              {
                "name": "languages",
                "text": "Comma-separated recognition languages in priority order, e.g. en-US,pt-BR (default: the system's default)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): capture in the background, bringing the app to the front only if its window isn't on screen; background: never bring it forward (error instead); foreground: bring the app to the front for the capture, then restore",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              },
              {
                "name": "scale",
                "text": "With --image: image pixels per point (the 'scale' from 'screenshot'), so positions come out in points",
                "default": "1"
              },
              {
                "name": "timeout",
                "text": "Give up with a JSON error after this long, e.g. 30s, 2m (default 60s: the first recognition after installing or updating takes about 30s)",
                "default": "60s"
              }
            ]
          }
        },
        {
          "name": "wait",
          "execute": [
            "${packageDir}/aux4-computer-mac wait values(text, role, app, gone, source, timeout, interval)"
          ],
          "help": {
            "text": "Wait until text, an element or an app window appears (or is gone), checking the accessibility tree first, then OCR",
            "variables": [
              {
                "name": "text",
                "text": "Text to wait for in element labels/values or on the pixels (ignores case, whitespace and commas, so 1792 matches 1,792)",
                "default": "",
                "arg": true
              },
              {
                "name": "role",
                "text": "Only elements with this AX role, e.g. AXButton (accessibility only)",
                "default": ""
              },
              {
                "name": "app",
                "text": "App to watch (defaults to the frontmost app / the whole screen); alone, wait until it is running with an on-screen window",
                "default": ""
              },
              {
                "name": "gone",
                "text": "true: wait until the text, element or app window is no longer there",
                "default": "false",
                "options": [
                  "false",
                  "true"
                ]
              },
              {
                "name": "source",
                "text": "auto (default): accessibility first, OCR of the app window (or screen) when accessibility has no match; ax or ocr: only that one",
                "default": "auto",
                "options": [
                  "auto",
                  "ax",
                  "ocr"
                ]
              },
              {
                "name": "timeout",
                "text": "How long to wait before failing, e.g. 500ms, 10s, 2m",
                "default": "10s"
              },
              {
                "name": "interval",
                "text": "Pause between checks, e.g. 250ms, 1s (checks never overlap)",
                "default": "500ms"
              }
            ]
          }
        },
        {
          "name": "read",
          "execute": [
            "${packageDir}/aux4-computer-mac read values(app, depth)"
          ],
          "help": {
            "text": "Read the accessibility tree of the frontmost or named app",
            "variables": [
              {
                "name": "app",
                "text": "App name to read (defaults to the frontmost app)",
                "default": ""
              },
              {
                "name": "depth",
                "text": "Maximum tree depth to walk",
                "default": "10"
              }
            ]
          }
        },
        {
          "name": "find",
          "execute": [
            "${packageDir}/aux4-computer-mac find values(text, role, app)"
          ],
          "help": {
            "text": "Find UI elements by text and/or role",
            "variables": [
              {
                "name": "text",
                "text": "Text to search for in element label/value",
                "default": "",
                "arg": true
              },
              {
                "name": "role",
                "text": "Filter by AX role, e.g. AXButton",
                "default": ""
              },
              {
                "name": "app",
                "text": "App to search (defaults to the frontmost app)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "click",
          "execute": [
            "${packageDir}/aux4-computer-mac click values(x, y, button, count, element, app, mode)"
          ],
          "help": {
            "text": "Click at coordinates or press an element; in the background by default",
            "variables": [
              {
                "name": "x",
                "text": "X coordinate: relative to the app's window with --app (same as 'screenshot --app'), screen points without",
                "default": ""
              },
              {
                "name": "y",
                "text": "Y coordinate: relative to the app's window with --app (same as 'screenshot --app'), screen points without",
                "default": ""
              },
              {
                "name": "button",
                "text": "left or right",
                "default": "left"
              },
              {
                "name": "count",
                "text": "Click count (2 for double-click)",
                "default": "1"
              },
              {
                "name": "element",
                "text": "Element ref from 'read'/'find' to press instead of x/y",
                "default": ""
              },
              {
                "name": "app",
                "text": "Target app; x/y become relative to its window (default: the frontmost app, screen points)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              }
            ]
          }
        },
        {
          "name": "move",
          "execute": [
            "${packageDir}/aux4-computer-mac move values(x, y)"
          ],
          "help": {
            "text": "Move the mouse cursor to screen coordinates (always real foreground)",
            "variables": [
              {
                "name": "x",
                "text": "X coordinate in screen points"
              },
              {
                "name": "y",
                "text": "Y coordinate in screen points"
              }
            ]
          }
        },
        {
          "name": "drag",
          "execute": [
            "${packageDir}/aux4-computer-mac drag values(x, y, toX, toY)"
          ],
          "help": {
            "text": "Drag the mouse from one point to another (always real foreground)",
            "variables": [
              {
                "name": "x",
                "text": "Start X coordinate"
              },
              {
                "name": "y",
                "text": "Start Y coordinate"
              },
              {
                "name": "toX",
                "text": "End X coordinate"
              },
              {
                "name": "toY",
                "text": "End Y coordinate"
              }
            ]
          }
        },
        {
          "name": "type",
          "execute": [
            "${packageDir}/aux4-computer-mac type values(text, delay, app, mode)"
          ],
          "help": {
            "text": "Type unicode-safe text into the focused element of an app; in the background by default",
            "variables": [
              {
                "name": "text",
                "text": "Text to type",
                "arg": true
              },
              {
                "name": "delay",
                "text": "Milliseconds to wait before typing (e.g. for a panel to appear)",
                "default": "0"
              },
              {
                "name": "app",
                "text": "App to type into (default: the frontmost app)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              }
            ]
          }
        },
        {
          "name": "shortcut",
          "execute": [
            "${packageDir}/aux4-computer-mac shortcut values(keys, delay, app, mode)"
          ],
          "help": {
            "text": "Press a keyboard shortcut, e.g. cmd+shift+4",
            "variables": [
              {
                "name": "keys",
                "text": "Key combo, e.g. 'cmd+c', 'cmd+shift+4', 'enter', 'escape'",
                "arg": true
              },
              {
                "name": "delay",
                "text": "Milliseconds to wait before pressing",
                "default": "0"
              },
              {
                "name": "app",
                "text": "Send the shortcut to this app (background when possible); without it the shortcut is system-wide (real input)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              }
            ]
          }
        },
        {
          "name": "scroll",
          "execute": [
            "${packageDir}/aux4-computer-mac scroll values(x, y, dx, dy, app, mode)"
          ],
          "help": {
            "text": "Scroll at a position in an app; in the background by default",
            "variables": [
              {
                "name": "x",
                "text": "X coordinate to scroll at: relative to the app's window with --app, screen points without",
                "default": ""
              },
              {
                "name": "y",
                "text": "Y coordinate to scroll at: relative to the app's window with --app, screen points without",
                "default": ""
              },
              {
                "name": "dx",
                "text": "Horizontal scroll delta in pixels",
                "default": "0"
              },
              {
                "name": "dy",
                "text": "Vertical scroll delta in pixels",
                "default": "0"
              },
              {
                "name": "app",
                "text": "App to scroll (default: the frontmost app)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              }
            ]
          }
        },
        {
          "name": "cursor",
          "execute": [
            "${packageDir}/aux4-computer-mac cursor"
          ],
          "help": {
            "text": "Get the current mouse cursor position"
          }
        },
        {
          "name": "screen",
          "execute": [
            "${packageDir}/aux4-computer-mac screen"
          ],
          "help": {
            "text": "List displays with bounds and scale factor"
          }
        },
        {
          "name": "apps",
          "execute": [
            "${packageDir}/aux4-computer-mac apps"
          ],
          "help": {
            "text": "List running applications"
          }
        },
        {
          "name": "windows",
          "execute": [
            "${packageDir}/aux4-computer-mac windows"
          ],
          "help": {
            "text": "List on-screen windows"
          }
        },
        {
          "name": "window",
          "execute": [
            "profile:computer:mac:window"
          ],
          "help": {
            "text": "List, move, resize, minimize, restore, close, full-screen or raise an app's windows (in the background, except raise)"
          }
        },
        {
          "name": "quit",
          "execute": [
            "${packageDir}/aux4-computer-mac quit values(app, force, timeout)"
          ],
          "help": {
            "text": "Quit an app (reports a 'save changes?' dialog instead of quitting); --force true kills it",
            "variables": [
              {
                "name": "app",
                "text": "Application name or bundle id",
                "arg": true
              },
              {
                "name": "force",
                "text": "Force-quit (unsaved changes are lost; refused for Finder)",
                "default": "false",
                "options": [
                  "false",
                  "true"
                ]
              },
              {
                "name": "timeout",
                "text": "How long to wait for the app to exit, e.g. 5s",
                "default": "5s"
              }
            ]
          }
        },
        {
          "name": "hide",
          "execute": [
            "${packageDir}/aux4-computer-mac hide values(app)"
          ],
          "help": {
            "text": "Hide an app (like cmd+h, without activating anything)",
            "variables": [
              {
                "name": "app",
                "text": "Application name or bundle id",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "unhide",
          "execute": [
            "${packageDir}/aux4-computer-mac unhide values(app)"
          ],
          "help": {
            "text": "Show a hidden app again without bringing it to the front",
            "variables": [
              {
                "name": "app",
                "text": "Application name or bundle id",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "open",
          "execute": [
            "${packageDir}/aux4-computer-mac open values(app, mode, file, url, wait, hidden)"
          ],
          "help": {
            "text": "Open an app, a file or a URL without bringing anything to the front (by default); optionally wait for its window",
            "variables": [
              {
                "name": "app",
                "text": "Application name or bundle id (com.apple.TextEdit); optional with --file/--url (their default app is used)",
                "default": "",
                "arg": true
              },
              {
                "name": "mode",
                "text": "auto (default): open without activating, put the frontmost app back if the app activates itself; background: same, error instead of bringing anything forward; foreground: open and activate the app",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              },
              {
                "name": "file",
                "text": "File to open (in --app, or its default app)",
                "default": ""
              },
              {
                "name": "url",
                "text": "URL to open (in --app, or the default handler), e.g. https://aux4.io",
                "default": ""
              },
              {
                "name": "wait",
                "text": "Wait up to this long for the app's window (the file's window with --file) and return its frame, e.g. 10s",
                "default": ""
              },
              {
                "name": "hidden",
                "text": "Launch the app hidden",
                "default": "false",
                "options": [
                  "false",
                  "true"
                ]
              }
            ]
          }
        },
        {
          "name": "focus",
          "execute": [
            "${packageDir}/aux4-computer-mac focus values(app)"
          ],
          "help": {
            "text": "Bring a running application to the foreground (always real foreground)",
            "variables": [
              {
                "name": "app",
                "text": "Application name",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "state",
          "execute": [
            "${packageDir}/aux4-computer-mac state values(app, depth, limit)"
          ],
          "help": {
            "text": "One-call snapshot: frontmost app, the app's windows, focused element, open dialog and a compact tree of its actionable/text elements",
            "variables": [
              {
                "name": "app",
                "text": "App to describe: name or bundle id (default: the frontmost app)",
                "default": ""
              },
              {
                "name": "depth",
                "text": "Levels of actionable/text elements to include (layout groups don't count; 0 = none)",
                "default": "3"
              },
              {
                "name": "limit",
                "text": "Maximum number of elements in the compact tree",
                "default": "120"
              }
            ]
          }
        },
        {
          "name": "menu",
          "execute": [
            "${packageDir}/aux4-computer-mac menu values(app, path, depth, mode)"
          ],
          "help": {
            "text": "List an app's menu bar, or press a menu item by path (e.g. 'Format > Font > Bold'); in the background by default",
            "variables": [
              {
                "name": "app",
                "text": "App whose menu bar to use: name or bundle id (default: the frontmost app)",
                "default": ""
              },
              {
                "name": "path",
                "text": "Menu item to press, titles separated by '>' (case-insensitive, trailing '…' optional); omit to list the menu bar",
                "default": ""
              },
              {
                "name": "depth",
                "text": "Menu levels to list: 1 = menu titles, 2 = their items (default), 3+ = submenus",
                "default": "2"
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              }
            ]
          }
        },
        {
          "name": "select",
          "execute": [
            "${packageDir}/aux4-computer-mac select values(app, all, text, occurrence, start, length, element, mode)"
          ],
          "help": {
            "text": "Select text in the focused (or given) text element through Accessibility; in the background",
            "variables": [
              {
                "name": "app",
                "text": "App to select in: name or bundle id (default: the frontmost app)",
                "default": ""
              },
              {
                "name": "all",
                "text": "Select all the element's text",
                "default": "false",
                "options": [
                  "false",
                  "true"
                ]
              },
              {
                "name": "text",
                "text": "Select this text (case-insensitive)",
                "default": ""
              },
              {
                "name": "occurrence",
                "text": "Which match of --text to select (1 = first)",
                "default": ""
              },
              {
                "name": "start",
                "text": "Start of the range to select (character offset from 0)",
                "default": ""
              },
              {
                "name": "length",
                "text": "Length of the range to select (characters)",
                "default": ""
              },
              {
                "name": "element",
                "text": "Text element ref from 'find' or 'state' (default: the app's focused element)",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              }
            ]
          }
        },
        {
          "name": "set",
          "execute": [
            "${packageDir}/aux4-computer-mac set values(app, element, value, checked, option, mode)"
          ],
          "help": {
            "text": "Set an element: a text field or slider value, a checkbox state or a pop-up option; in the background",
            "variables": [
              {
                "name": "app",
                "text": "App the element belongs to: name or bundle id (default: the frontmost app)",
                "default": ""
              },
              {
                "name": "element",
                "text": "Element ref from 'find' or 'state'",
                "default": ""
              },
              {
                "name": "value",
                "text": "New value for a text field, text area, combo box or slider",
                "default": ""
              },
              {
                "name": "checked",
                "text": "true or false: press the checkbox/radio button until it is in that state",
                "default": ""
              },
              {
                "name": "option",
                "text": "Option title to pick in a pop-up button, combo box or radio group",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              }
            ]
          }
        },
        {
          "name": "dialog",
          "execute": [
            "${packageDir}/aux4-computer-mac dialog values(app, press, mode)"
          ],
          "help": {
            "text": "Detect an open alert, sheet, dialog or save/open panel (kind, title, text, buttons, fields); --press a button by title",
            "variables": [
              {
                "name": "app",
                "text": "App to check: name or bundle id (default: the frontmost app, then system alerts)",
                "default": ""
              },
              {
                "name": "press",
                "text": "Button to press, by title (case-insensitive, e.g. \"Don't Save\")",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to real input only if that isn't possible; background: never fall back (error instead); foreground: always use real input",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              }
            ]
          }
        },
        {
          "name": "log",
          "execute": [
            "${packageDir}/aux4-computer-mac log values(limit)"
          ],
          "help": {
            "text": "Show the most recent entries of the action log (every input/state command is recorded)",
            "variables": [
              {
                "name": "limit",
                "text": "Number of recent entries to show",
                "default": "20"
              }
            ]
          }
        },
        {
          "name": "stop",
          "execute": [
            "${packageDir}/aux4-computer-mac stop"
          ],
          "help": {
            "text": "Turn on the stop switch: every command that sends input or changes state refuses until 'resume'"
          }
        },
        {
          "name": "resume",
          "execute": [
            "${packageDir}/aux4-computer-mac resume"
          ],
          "help": {
            "text": "Turn off the stop switch so input and state commands work again"
          }
        },
        {
          "name": "clipboard",
          "execute": [
            "profile:computer:mac:clipboard"
          ],
          "help": {
            "text": "Clipboard commands: copy, paste, read"
          }
        }
      ]
    },
    {
      "name": "computer:mac:window",
      "commands": [
        {
          "name": "list",
          "execute": [
            "${packageDir}/aux4-computer-mac window list values(app)"
          ],
          "help": {
            "text": "List an app's windows (index, ref, title, frame, minimized, fullscreen, main, focused)",
            "variables": [
              {
                "name": "app",
                "text": "App whose windows to list: name or bundle id (default: the frontmost app)",
                "default": "",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "move",
          "execute": [
            "${packageDir}/aux4-computer-mac window move values(app, title, index, mode) values(x, y)"
          ],
          "help": {
            "text": "Move a window so its top-left corner is at --x/--y (screen points); returns the frame before and after",
            "variables": [
              {
                "name": "app",
                "text": "App whose window to use: name or bundle id (default: the frontmost app)",
                "default": ""
              },
              {
                "name": "title",
                "text": "Window title (exact, then contained; case-insensitive); default: the app's main window",
                "default": ""
              },
              {
                "name": "index",
                "text": "Window index from 'window list' (instead of --title)",
                "default": ""
              },
              {
                "name": "x",
                "text": "Screen x of the window's top-left corner (negative: --x=-100)",
                "default": ""
              },
              {
                "name": "y",
                "text": "Screen y of the window's top-left corner",
                "default": ""
              },
              {
                "name": "mode",
                "text": "auto (default): act in the background, fall back to bringing the app forward only if that isn't possible; background: never fall back (error instead); foreground: bring the app forward first",
                "default": "auto",
                "options": [
                  "auto",
                  "background",
                  "foreground"
                ]
              }
            ]
          }
        },
